@using Microsoft.AspNetCore.Identity;
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject UserManager<ApplicationUser> UserManager;

@if (!User.Identity.IsAuthenticated)
{
    <a class="btn btn-outline-success my-2 my-sm-0" asp-controller="Account" asp-action="Login">
        <i class="bi bi-box-arrow-in-right"></i> Login
    </a>
    <span style="padding: 5px;"></span>
    <a class="btn btn-outline-primary my-2 my-sm-0" asp-controller="Account" asp-action="Register">
        <i class="bi bi-person-plus"></i> Register
    </a>
}
else
{
    var isAdmin = User.IsInRole("Admin");
    var user = await UserManager.GetUserAsync(User);
    var userName = UserManager.GetUserName(User);
    var userEmail = await UserManager.GetEmailAsync(user);
    var userFullName = user?.FullName ?? userName;

    <div class="dropdown">
        <button class="btn btn-outline-success dropdown-toggle user-menu-btn" type="button" id="profile-btn" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="user-menu-content">
                @if (isAdmin)
                {
                    <span class="role-badge role-badge-admin">
                        <i class="bi bi-shield-fill-check"></i>Admin
                    </span>
                }
                else
                {
                    <span class="role-badge role-badge-user">
                        <i class="bi bi-person-fill"></i>User
                    </span>
                }
                <div class="user-menu-info">
                    <span class="user-name-text">@userFullName</span>
                    <span class="user-email-text">@userEmail</span>
                </div>
            </div>
        </button>
        <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu" aria-labelledby="profile-btn">

            @if (isAdmin)
            {
                <li class="dropdown-header-custom">
                    <i class="bi bi-gear-fill me-1"></i>Admin Panel
                </li>
                <li>
                    <a class="dropdown-item dropdown-item-custom" asp-controller="Orders" asp-action="Dashboard">
                        <i class="bi bi-speedometer2 me-2"></i>Dashboard
                    </a>
                </li>
                <li>
                    <a class="dropdown-item dropdown-item-custom" asp-controller="Cinemas" asp-action="Index">
                        <i class="bi bi-camera-reels-fill me-2"></i>Cinemas
                    </a>
                </li>
                <li>
                    <a class="dropdown-item dropdown-item-custom" asp-controller="Categories" asp-action="Index">
                        <i class="bi bi-tags-fill me-2"></i>Categories
                    </a>
                </li>
                <li>
                    <a class="dropdown-item dropdown-item-custom" asp-controller="Vouchers" asp-action="Index">
                        <i class="bi bi-gift-fill me-2"></i>Vouchers
                    </a>
                </li>
                <li>
                    <a class="dropdown-item dropdown-item-custom" asp-controller="CinemaRooms" asp-action="Index">
                        <i class="bi bi-door-open-fill me-2"></i>Rooms
                    </a>
                </li>
                <li>
                    <a class="dropdown-item dropdown-item-custom text-warning" asp-controller="Orders" asp-action="ManageBookings">
                        <i class="bi bi-person-gear me-2"></i>Bookings
                    </a>
                </li>
                <li>
                    <a class="dropdown-item dropdown-item-custom text-info" asp-controller="Orders" asp-action="Revenue">
                        <i class="bi bi-graph-up-arrow me-2"></i>Revenue
                    </a>
                </li>
                <li>
                    <a class="dropdown-item dropdown-item-custom text-success" asp-controller="Orders" asp-action="Reports">
                        <i class="bi bi-file-earmark-bar-graph me-2"></i>Reports
                    </a>
                </li>
                <li>
                    <a class="dropdown-item dropdown-item-custom" asp-controller="Showtimes" asp-action="Index">
                        <i class="bi bi-calendar3 me-2"></i>Showtimes
                    </a>
                </li>
                <li>
                    <a class="dropdown-item dropdown-item-custom" asp-controller="Producers" asp-action="Index">
                        <i class="bi bi-headset me-2"></i>Producers
                    </a>
                </li>
                <li>
                    <a class="dropdown-item dropdown-item-custom" asp-controller="Actors" asp-action="Index">
                        <i class="bi bi-person-badge-fill me-2"></i>Actors
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
            }

            <li class="dropdown-header-custom">
                <i class="bi bi-person me-1"></i>Tài khoản
            </li>
            <li>
                <a class="dropdown-item dropdown-item-custom" asp-controller="Orders" asp-action="Index">
                    <i class="bi bi-clock-history me-2"></i>Lịch sử giao dịch
                </a>
            </li>

            <li><hr class="dropdown-divider"></li>

            <li>
                <form asp-controller="Account" asp-action="Logout" class="m-0">
                    <button type="submit" class="dropdown-item dropdown-item-custom text-danger logout-btn">
                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                    </button>
                </form>
            </li>
        </ul>
    </div>
}
