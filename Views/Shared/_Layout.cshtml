<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MovieCinema</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/movieCinema.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-cinema sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Movies" asp-action="Index">
                    <i class="bi bi-ticket-perforated-fill me-2"></i>MovieCinema
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Movies" asp-action="Index">
                                <i class="bi bi-film text-info"></i>Movies
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Showtimes" asp-action="Schedule">
                                <i class="bi bi-calendar3 text-warning"></i>Lịch chiếu
                            </a>
                        </li>

                        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-warning" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-fill-check"></i>Admin Panel
                                </a>

                                <div class="dropdown-menu dropdown-menu-dark" aria-labelledby="navbarDropdown">
                                    <a class="dropdown-item text-primary fw-bold" asp-controller="Orders" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" asp-controller="Cinemas" asp-action="Index"><i class="bi bi-camera-reels-fill me-1"></i>Cinemas</a>
                                    <a class="dropdown-item" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags-fill me-1"></i>Categories</a>
                                    <a class="dropdown-item" asp-controller="Vouchers" asp-action="Index"><i class="bi bi-gift-fill me-1"></i>Vouchers</a>
                                    <a class="dropdown-item" asp-controller="CinemaRooms" asp-action="Index"><i class="bi bi-door-open-fill me-1"></i>Rooms</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item text-warning" asp-controller="Orders" asp-action="ManageBookings"><i class="bi bi-person-gear me-1"></i>Bookings</a>
                                    <a class="dropdown-item text-info" asp-controller="Orders" asp-action="Revenue"><i class="bi bi-graph-up-arrow me-1"></i>Revenue</a>
                                    <a class="dropdown-item text-success" asp-controller="Orders" asp-action="Reports"><i class="bi bi-file-earmark-bar-graph me-1"></i>Reports</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" asp-controller="Showtimes" asp-action="Index"><i class="bi bi-calendar3 me-1"></i>Showtimes</a>
                                    <a class="dropdown-item" asp-controller="Producers" asp-action="Index"><i class="bi bi-headset me-1"></i>Producers</a>
                                </div>
                            </li>
                        }
                    </ul>

                    <form class="d-flex search-box-container me-lg-3" asp-controller="Movies" asp-action="Filter">
                        <input name="searchString" type="text" class="form-control" placeholder="Search for a movie..." aria-label="Search">
                        <button class="search-btn" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>

                    <ul class="navbar-nav">
                        @await Component.InvokeAsync("ShoppingCartSummary")
                    </ul>

                    <partial name="_Identity.cshtml"/>

                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-md-5 my-4 flex-grow-1">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-cinema">
        <div class="container-fluid px-md-5">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div>
                    <span class="fw-bold text-white me-2"><i class="bi bi-ticket-perforated-fill text-info me-1"></i>MovieCinema</span> &copy; 2026 - All rights reserved.
                </div>
                <div class="d-flex gap-4">
                    <a href="#" class="text-muted"><i class="bi bi-facebook fs-5"></i></a>
                    <a href="#" class="text-muted"><i class="bi bi-instagram fs-5"></i></a>
                    <a href="#" class="text-muted"><i class="bi bi-twitter-x fs-5"></i></a>
                    <a href="#" class="text-muted"><i class="bi bi-youtube fs-5"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>