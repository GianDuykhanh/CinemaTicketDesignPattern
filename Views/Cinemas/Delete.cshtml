@model Cinema

@{
    ViewData["Title"] = "Delete cinema";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">

        <!-- Header -->
        <div class="d-flex align-items-center gap-3 mb-5 pb-4 border-bottom border-secondary-subtle">
            <a asp-action="Index" class="btn btn-sm btn-premium-outline px-3 d-flex align-items-center justify-content-center" style="width: auto; height: 38px; border-radius: 10px;" title="Cancel and go back">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h1 class="h2 fw-bold text-white mb-1"><i class="bi bi-shield-exclamation text-danger me-2"></i>Delete Cinema</h1>
                <p class="text-muted mb-0 small">Remove this cinema profile permanently from the database directory</p>
            </div>
        </div>

        <!-- Glass Delete Confirmation Card -->
        <div class="cinema-delete-glass-card">

            <!-- Warning Box -->
            <div class="cinema-warning-alert-box">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div>
                    <h4 class="h6 fw-bold text-white mb-1">Critical Warning!</h4>
                    Deleting this cinema profile will permanently erase all associated data including description records and related showtimes. This operation is **irreversible**.
                </div>
            </div>

            <!-- Cinema Summary Card -->
            <div class="cinema-spotlight-card">
                <div class="cinema-delete-picture-ring">
                    <img class="cinema-delete-picture-img" src="@Model.Logo" alt="@Model.Name" onerror="this.onerror=null;this.src='/images/default-logo.png';" />
                </div>
                <h2 class="h4 fw-bold text-white mb-2">@Model.Name</h2>
                <div class="d-flex flex-wrap justify-content-center gap-2 mb-3">
                    <span class="tech-badge tech-imax"><i class="bi bi-display"></i> IMAX</span>
                    <span class="tech-badge tech-dolby"><i class="bi bi-volume-up-fill"></i> Dolby</span>
                </div>
                <p class="cinema-delete-bio">@Model.Description</p>
            </div>

            <!-- Form Confirmation Actions -->
            <div class="d-flex flex-sm-row flex-column gap-3 justify-content-center pt-4 border-top border-secondary-subtle">
                <a class="btn btn-premium-outline px-4 py-2" asp-action="Index" style="width: auto;">
                    <i class="bi bi-x-circle me-2"></i>Cancel, Go Back
                </a>
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-cinema-danger px-5 py-2 w-100">
                        <i class="bi bi-trash3-fill me-2"></i>Confirm Delete
                    </button>
                </form>
            </div>

        </div>

    </div>
</div>