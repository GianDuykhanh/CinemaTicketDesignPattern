@model CinemaRoom

@{
    ViewData["Title"] = "Add a new room";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-10">
        
        <!-- Header -->
        <div class="d-flex align-items-center gap-3 mb-5 pb-4 border-bottom border-secondary-subtle">
            <a asp-action="Index" class="btn btn-sm btn-premium-outline px-3 d-flex align-items-center justify-content-center" style="width: auto; height: 38px; border-radius: 10px;" title="Go back to list">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h1 class="h2 fw-bold text-white mb-1"><i class="bi bi-plus-circle text-info me-2"></i>Add a New Room</h1>
                <p class="text-muted mb-0 small">Create a new screening room profile in the directory</p>
            </div>
        </div>

        <!-- Glass card Form -->
        <div class="form-glass-card">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                <div class="row g-4">
                    <div class="col-12 d-flex flex-column gap-3">
                        <div class="form-group">
                            <label asp-for="CinemaId" class="form-label-premium"><i class="bi bi-building"></i>Select Cinema</label>
                            <select asp-for="CinemaId" class="form-select form-control-glass" asp-items="ViewBag.Cinemas">
                                <option value="">-- Select a Cinema --</option>
                            </select>
                            <span asp-validation-for="CinemaId" class="text-danger small mt-1 d-block fw-semibold"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Name" class="form-label-premium"><i class="bi bi-door-open-fill"></i>Room Name</label>
                            <input asp-for="Name" class="form-control form-control-glass" placeholder="Enter room name (e.g. Room 1, Room IMAX)" autocomplete="off" />
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block fw-semibold"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Capacity" class="form-label-premium"><i class="bi bi-people-fill"></i>Seat Capacity</label>
                            <input asp-for="Capacity" type="number" min="1" class="form-control form-control-glass" placeholder="Enter seat capacity (e.g. 150)" />
                            <span asp-validation-for="Capacity" class="text-danger small mt-1 d-block fw-semibold"></span>
                        </div>

                        <!-- Buttons Row -->
                        <div class="d-flex flex-sm-row flex-column gap-3 justify-content-end pt-4 border-top border-secondary-subtle mt-3">
                            <a class="btn btn-premium-outline px-4 py-2" asp-action="Index" style="width: auto;">
                                <i class="bi bi-list-stars me-2"></i>Show All
                            </a>
                            <button type="submit" class="btn btn-premium-gradient px-5 py-2" style="width: auto;">
                                <i class="bi bi-plus-circle-fill me-2"></i>Create Room
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>

    </div>
</div>
