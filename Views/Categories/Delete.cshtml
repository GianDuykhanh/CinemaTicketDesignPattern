@model Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">

        <!-- Header -->
        <div class="d-flex align-items-center gap-3 mb-5 pb-4 border-bottom border-secondary-subtle">
            <a asp-action="Index" class="btn btn-sm btn-premium-outline px-3 d-flex align-items-center justify-content-center" style="width: auto; height: 38px; border-radius: 10px;" title="Cancel and go back">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h1 class="h2 fw-bold text-white mb-1"><i class="bi bi-shield-exclamation text-danger me-2"></i>Delete Category</h1>
                <p class="text-muted mb-0 small">Remove this category permanently from the database</p>
            </div>
        </div>

        <!-- Glass Delete Confirmation Card -->
        <div class="cinema-delete-glass-card p-5">

            <!-- Warning Box -->
            <div class="cinema-warning-alert-box mb-4">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-3"></i>
                <div>
                    <h4 class="h6 fw-bold text-white mb-1">Critical Warning!</h4>
                    Deleting this category profile will permanently remove it from the system. Any movies linked to this category may need to be reclassified. This operation is **irreversible**.
                </div>
            </div>

            <!-- Category Summary Card -->
            <div class="cinema-spotlight-card text-center mb-4">
                <div class="cinema-logo-ring d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger mb-3" style="width: 80px; height: 80px; font-size: 2.2rem; border-radius: 20px; border: 1px solid rgba(220, 53, 69, 0.25);">
                    <i class="bi bi-tag-fill"></i>
                </div>
                <h2 class="h4 fw-bold text-white mb-2">@Model.Name</h2>
                <p class="cinema-delete-bio text-muted">@Model.Description</p>
            </div>

            <!-- Form Confirmation Actions -->
            <div class="d-flex flex-sm-row flex-column gap-3 justify-content-center pt-4 border-top border-secondary-subtle">
                <a class="btn btn-premium-outline px-4 py-2" asp-action="Index" style="width: auto;">
                    <i class="bi bi-x-circle me-2"></i>Cancel, Go Back
                </a>
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-cinema-danger px-5 py-2 w-100">
                        <i class="bi bi-trash3-fill me-2"></i>Confirm Delete
                    </button>
                </form>
            </div>

        </div>

    </div>
</div>
