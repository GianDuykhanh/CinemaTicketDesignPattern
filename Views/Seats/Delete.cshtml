@model Seat

@{
    ViewData["Title"] = "Delete Seat";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-5 col-lg-4">

        <div class="d-flex align-items-center gap-3 mb-5 pb-4 border-bottom border-secondary-subtle">
            <a asp-action="Index" asp-route-roomId="@ViewBag.RoomId" class="btn btn-sm btn-premium-outline px-3 d-flex align-items-center justify-content-center" style="width: auto; height: 38px; border-radius: 10px;">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h1 class="h2 fw-bold text-white mb-1"><i class="bi bi-trash-fill text-danger me-2"></i>Delete Seat</h1>
                <p class="text-muted mb-0 small">Confirm deletion</p>
            </div>
        </div>

        <div class="glass-panel p-5 text-center" style="background: rgba(15,23,42,0.45); border: 1px solid rgba(255,255,255,0.08); border-radius: 24px;">
            <div class="mb-4">
                <div class="d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px; border-radius: 50%; background: rgba(239,68,68,0.15); font-size: 2rem; color: #ef4444;">
                    <i class="bi bi-chair"></i>
                </div>
            </div>

            <h4 class="text-white mb-2">Row @Model.Row - Seat @Model.Number</h4>
            <p class="text-muted mb-1">@Model.SeatType seat</p>
            <p class="text-muted small">in <strong class="text-white">@((ViewBag.Room as CinemaRoom)?.Name)</strong></p>

            <div class="alert mt-4 mb-4" style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); border-radius: 12px; color: #fca5a5;">
                <i class="bi bi-exclamation-triangle me-2"></i>This action cannot be undone.
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="roomId" value="@ViewBag.RoomId" />
                <div class="d-flex gap-3 justify-content-center">
                    <a asp-action="Index" asp-route-roomId="@ViewBag.RoomId" class="btn btn-premium-outline px-4 py-2">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4 py-2">
                        <i class="bi bi-trash-fill me-2"></i>Delete
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>