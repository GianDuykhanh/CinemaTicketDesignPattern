@model CinemaRoom

@{
    ViewData["Title"] = "Generate Seats - " + (ViewBag.Room as CinemaRoom)?.Name;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-6 col-lg-5">

        <div class="d-flex align-items-center gap-3 mb-5 pb-4 border-bottom border-secondary-subtle">
            <a asp-action="Index" asp-route-roomId="@ViewBag.RoomId" class="btn btn-sm btn-premium-outline px-3 d-flex align-items-center justify-content-center" style="width: auto; height: 38px; border-radius: 10px;">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h1 class="h2 fw-bold text-white mb-1"><i class="bi bi-grid-3x3-gap-fill text-info me-2"></i>Generate Seats</h1>
                <p class="text-muted mb-0 small">Auto-generate seats for @((ViewBag.Room as CinemaRoom)?.Name)</p>
            </div>
        </div>

        <div class="glass-panel p-5" style="background: rgba(15,23,42,0.45); border: 1px solid rgba(255,255,255,0.08); border-radius: 24px; box-shadow: 0 20px 50px rgba(0,0,0,0.4);">
            <form asp-action="Create" method="post">
                <input type="hidden" name="roomId" value="@ViewBag.RoomId" />

                <div class="mb-4">
                    <label class="form-label text-white fw-semibold">
                        <i class="bi bi-layout-three-columns text-info me-1"></i>Number of Rows
                    </label>
                    <input type="number" name="Rows" class="form-control" value="10" min="1" max="26" required style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); color: white; border-radius: 12px; padding: 12px 16px;" />
                    <small class="text-muted">A–Z (max 26 rows)</small>
                    @Html.ValidationMessage("Rows", "", new { @class = "text-danger small" })
                </div>

                <div class="mb-4">
                    <label class="form-label text-white fw-semibold">
                        <i class="bi bi-ui-checks-grid text-info me-1"></i>Seats per Row
                    </label>
                    <input type="number" name="SeatsPerRow" class="form-control" value="12" min="1" max="50" required style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); color: white; border-radius: 12px; padding: 12px 16px;" />
                    <small class="text-muted">1–50 seats per row</small>
                    @Html.ValidationMessage("SeatsPerRow", "", new { @class = "text-danger small" })
                </div>

                @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3 d-block" })

                <!-- Preview -->
                <div class="alert mb-4" style="background: rgba(6,182,212,0.1); border: 1px solid rgba(6,182,212,0.25); border-radius: 12px;">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-info-circle text-info"></i>
                        <span class="small text-white fw-semibold">Seat Layout Preview</span>
                    </div>
                    <div class="small text-muted">
                        <ul class="mb-0 ps-3">
                            <li>Last 2 rows → <span style="color:#fbbf24;font-weight:600;">VIP seats</span></li>
                            <li>Last 2 seats of each row → <span style="color:#ec4899;font-weight:600;">Couple seats</span></li>
                            <li>First row, first seat → <span style="color:#6c757d;font-weight:600;">Disabled seat</span></li>
                            <li>All other seats → <span style="color:#adb5bd;font-weight:600;">Standard seats</span></li>
                        </ul>
                    </div>
                </div>

                <div class="d-flex gap-3 justify-content-end">
                    <a asp-action="Index" asp-route-roomId="@ViewBag.RoomId" class="btn btn-premium-outline px-4 py-2">Cancel</a>
                    <button type="submit" class="btn btn-premium-gradient px-4 py-2">
                        <i class="bi bi-lightning-charge me-2"></i>Generate
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>