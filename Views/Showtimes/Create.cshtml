@model Showtime

@{
    ViewData["Title"] = "Add a new showtime";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-10">
        
        <!-- Header -->
        <div class="d-flex align-items-center gap-3 mb-5 pb-4 border-bottom border-secondary-subtle">
            <a asp-action="Index" class="btn btn-sm btn-premium-outline px-3 d-flex align-items-center justify-content-center" style="width: auto; height: 38px; border-radius: 10px;" title="Go back to list">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h1 class="h2 fw-bold text-white mb-1"><i class="bi bi-calendar-plus text-info me-2"></i>Add a New Showtime</h1>
                <p class="text-muted mb-0 small">Create a new screening schedule for a movie</p>
            </div>
        </div>

        <!-- Glass card Form -->
        <div class="form-glass-card">
            @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
            {
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                <div class="row g-4">
                    <div class="col-12 d-flex flex-column gap-3">
                        <div class="form-group">
                            <label asp-for="MovieId" class="form-label-premium"><i class="bi bi-film"></i>Select Movie</label>
                            <select asp-for="MovieId" class="form-select form-control-glass" asp-items="ViewBag.Movies">
                                <option value="">-- Select a Movie --</option>
                            </select>
                            <span asp-validation-for="MovieId" class="text-danger small mt-1 d-block fw-semibold"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label-premium"><i class="bi bi-door-open-fill"></i>Select Screening Rooms (Choose one or more)</label>
                            <div class="row g-2 px-2" style="max-height: 200px; overflow-y: auto; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 10px;">
                                @if (ViewBag.CinemaRoomsList != null)
                                {
                                    @foreach (var room in (IEnumerable<SelectListItem>)ViewBag.CinemaRoomsList)
                                    {
                                        <div class="col-md-6 col-12">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="CinemaRoomIds" value="@room.Value" id="room_@room.Value" @(room.Selected ? "checked" : "") />
                                                <label class="form-check-label text-white-50" for="room_@room.Value" style="cursor: pointer; font-size: 0.85rem;">
                                                    @room.Text
                                                </label>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                            <span asp-validation-for="CinemaRoomId" class="text-danger small mt-1 d-block fw-semibold"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label asp-for="StartTime" class="form-label-premium"><i class="bi bi-play-circle"></i>Start Time</label>
                                <input asp-for="StartTime" type="datetime-local" class="form-control form-control-glass" />
                                <span asp-validation-for="StartTime" class="text-danger small mt-1 d-block fw-semibold"></span>
                            </div>

                            <div class="col-md-6 form-group">
                                <label asp-for="EndTime" class="form-label-premium"><i class="bi bi-stop-circle"></i>End Time</label>
                                <input asp-for="EndTime" type="datetime-local" class="form-control form-control-glass" />
                                <span asp-validation-for="EndTime" class="text-danger small mt-1 d-block fw-semibold"></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label asp-for="Price" class="form-label-premium"><i class="bi bi-tag-fill"></i>Ticket Price (đ)</label>
                            <input asp-for="Price" type="number" min="0" step="500" class="form-control form-control-glass" placeholder="Enter ticket price (e.g. 50000)" />
                            <span asp-validation-for="Price" class="text-danger small mt-1 d-block fw-semibold"></span>
                        </div>

                        <!-- Buttons Row -->
                        <div class="d-flex flex-sm-row flex-column gap-3 justify-content-end pt-4 border-top border-secondary-subtle mt-3">
                            <a class="btn btn-premium-outline px-4 py-2" asp-action="Index" style="width: auto;">
                                <i class="bi bi-list-stars me-2"></i>Show All
                            </a>
                            <button type="submit" class="btn btn-premium-gradient px-5 py-2" style="width: auto;">
                                <i class="bi bi-plus-circle-fill me-2"></i>Create Showtime
                            </button>
                        </div>
                    </div>
                </div>
            </form>
            }
            else
            {
                <div class="alert alert-danger mt-4">Bạn không có quyền truy cập trang này.</div>
                <a asp-action="Index" class="btn btn-outline-light">Quay lại</a>
            }
        </div>

    </div>
</div>
