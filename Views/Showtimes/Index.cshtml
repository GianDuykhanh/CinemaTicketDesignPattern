@model IEnumerable<Showtime>

@{
    ViewData["Title"] = "Showtimes Management";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white"><i class="bi bi-calendar3 text-info me-2"></i>Showtimes Management</h2>
    </div>

    <div class="row">
        @if (Model == null || !Model.Any())
        {
            <div class="col-12 text-center my-5 py-5 glass-panel" style="background: rgba(15, 23, 42, 0.45); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 20px;">
                <i class="bi bi-calendar-x text-muted" style="font-size: 4rem;"></i>
                <h4 class="text-white mt-3">No showtimes found</h4>
                <p class="text-muted small">Create showtimes to allow users to book movie tickets.</p>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-xl-4 col-md-6 mb-4">
                    <div class="glass-panel h-100 p-3 hover-lift d-flex flex-column" style="background: rgba(15, 23, 42, 0.45); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 20px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25); transition: all 0.3s ease;">
                        <div class="d-flex gap-3 mb-3">
                            <div class="showtime-poster-wrapper" style="width: 90px; height: 130px; border-radius: 12px; overflow: hidden; flex-shrink: 0; border: 1px solid rgba(255, 255, 255, 0.1);">
                                <img src="@(item.Movie?.ImageURL ?? "")" alt="@(item.Movie?.Name ?? "N/A")" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null;this.src='/images/default-poster.png';" />
                            </div>
                            <div class="d-flex flex-column justify-content-between">
                                <div>
                                    <h5 class="text-white font-weight-bold mb-1" style="font-size: 1.1rem; line-height: 1.3;">@(item.Movie?.Name ?? "Movie N/A")</h5>
                                    <span class="badge" style="background: rgba(6, 182, 212, 0.15); color: var(--cinema-accent-cyan); border: 1px solid rgba(6, 182, 212, 0.3); font-size: 0.75rem; padding: 4px 8px; border-radius: 6px;">
                                        <i class="bi bi-film me-1"></i>@(item.Movie?.Category?.Name ?? "General")
                                    </span>
                                </div>
                                <div class="mt-2">
                                    <span class="text-warning fw-bold" style="font-size: 1.15rem;">
                                        @item.Price.ToString("N0") đ
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="showtime-details-box p-3 mb-3" style="background: rgba(255, 255, 255, 0.03); border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.05); font-size: 0.85rem;">
                            <div class="d-flex align-items-center mb-2 text-light">
                                <i class="bi bi-building text-info me-2"></i>
                                <span class="fw-semibold">Cinema:</span>&nbsp;@(item.CinemaRoom?.Cinema?.Name ?? "N/A")
                            </div>
                            <div class="d-flex align-items-center mb-2 text-light">
                                <i class="bi bi-door-open text-info me-2"></i>
                                <span class="fw-semibold">Room:</span>&nbsp;@(item.CinemaRoom?.Name ?? "N/A")
                            </div>
                            <div class="d-flex align-items-center mb-2 text-light">
                                <i class="bi bi-play-circle text-success me-2"></i>
                                <span class="fw-semibold">Start:</span>&nbsp;@item.StartTime.ToString("dd/MM/yyyy HH:mm")
                            </div>
                            <div class="d-flex align-items-center text-light">
                                <i class="bi bi-stop-circle text-danger me-2"></i>
                                <span class="fw-semibold">End:</span>&nbsp;@item.EndTime.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>

                        <div class="d-flex justify-content-center gap-3 mt-auto pt-2" style="border-top: 1px solid rgba(255, 255, 255, 0.08);">
                            <a class="btn cinema-action-btn" asp-action="Edit" asp-route-id="@item.Id" title="Edit">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a class="btn cinema-action-btn" style="color: var(--cinema-accent-cyan);" asp-action="Details" asp-route-id="@item.Id" title="Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a class="btn cinema-action-btn" style="color: var(--cinema-accent-rose);" asp-action="Delete" asp-route-id="@item.Id" title="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@await Html.PartialAsync("_CreateItem", "Showtimes")
