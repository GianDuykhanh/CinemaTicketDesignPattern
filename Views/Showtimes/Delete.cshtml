@model Showtime

@{
    ViewData["Title"] = "Delete showtime";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-10">
        
        <!-- Header -->
        <div class="d-flex align-items-center gap-3 mb-5 pb-4 border-bottom border-secondary-subtle">
            <a asp-action="Index" class="btn btn-sm btn-premium-outline px-3 d-flex align-items-center justify-content-center" style="width: auto; height: 38px; border-radius: 10px;" title="Go back to list">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h1 class="h2 fw-bold text-white mb-1"><i class="bi bi-trash text-danger me-2"></i>Delete Showtime</h1>
                <p class="text-muted mb-0 small">Remove this screening schedule permanently from the directory</p>
            </div>
        </div>

        <!-- Glass card Delete -->
        <div class="glass-panel p-5 text-white mb-4" style="background: rgba(15, 23, 42, 0.45); border: 1px solid rgba(244, 63, 94, 0.2); border-radius: 24px; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);">
            
            <div class="alert alert-danger mb-5 d-flex align-items-start gap-3" style="background: rgba(244, 63, 94, 0.1); border: 1px solid rgba(244, 63, 94, 0.25); border-radius: 16px; color: #fca5a5;">
                <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
                <div>
                    <h5 class="fw-bold mb-1">Warning!</h5>
                    <p class="mb-0 small">Are you sure you want to delete this showtime? This action cannot be undone and will affect any existing bookings/carts holding this schedule.</p>
                </div>
            </div>

            <div class="row g-4 align-items-center mb-5">
                <div class="col-12 col-md-3 text-center">
                    <div class="showtime-delete-poster mx-auto" style="width: 120px; height: 170px; border-radius: 16px; overflow: hidden; border: 2px solid rgba(244, 63, 94, 0.4); box-shadow: 0 10px 25px rgba(244, 63, 94, 0.25);">
                        <img src="@(Model.Movie?.ImageURL ?? "")" alt="@(Model.Movie?.Name ?? "N/A")" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null;this.src='/images/default-poster.png';" />
                    </div>
                </div>
                <div class="col-12 col-md-9">
                    <h2 class="fw-bold mb-3">@(Model.Movie?.Name ?? "Movie N/A")</h2>
                    
                    <div class="d-flex flex-column gap-2" style="font-size: 0.95rem;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-building text-danger"></i>
                            <span class="text-muted me-1">Cinema:</span>
                            <span class="fw-semibold">@(Model.CinemaRoom?.Cinema?.Name ?? "N/A")</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-door-open text-danger"></i>
                            <span class="text-muted me-1">Screening Room:</span>
                            <span class="fw-semibold">@(Model.CinemaRoom?.Name ?? "N/A")</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-play-circle text-danger"></i>
                            <span class="text-muted me-1">Start Time:</span>
                            <span class="fw-semibold">@Model.StartTime.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-stop-circle text-danger"></i>
                            <span class="text-muted me-1">End Time:</span>
                            <span class="fw-semibold">@Model.EndTime.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-tag-fill text-danger"></i>
                            <span class="text-muted me-1">Price:</span>
                            <span class="fw-semibold text-warning">@Model.Price.ToString("N0") đ</span>
                        </div>
                    </div>
                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                
                <div class="d-flex flex-sm-row flex-column gap-3 justify-content-end pt-4 border-top border-secondary-subtle">
                    <a class="btn btn-premium-outline px-4 py-2" asp-action="Index" style="width: auto;">
                        <i class="bi bi-arrow-left-circle me-2"></i>Back to List
                    </a>
                    <button type="submit" class="btn btn-danger px-5 py-2" style="background: linear-gradient(135deg, #f43f5e 0%, #be123c 100%); border: none; font-weight: 600; box-shadow: 0 4px 15px rgba(244, 63, 94, 0.3); border-radius: 10px; width: auto;">
                        <i class="bi bi-trash-fill me-2"></i>Delete Showtime
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>
