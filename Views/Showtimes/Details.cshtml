@model Showtime

@{
    ViewData["Title"] = "Showtime Details";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-10">
        
        <!-- Header -->
        <div class="d-flex align-items-center gap-3 mb-5 pb-4 border-bottom border-secondary-subtle">
            <a asp-action="Index" class="btn btn-sm btn-premium-outline px-3 d-flex align-items-center justify-content-center" style="width: auto; height: 38px; border-radius: 10px;" title="Go back to list">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h1 class="h2 fw-bold text-white mb-1"><i class="bi bi-calendar-event text-info me-2"></i>Showtime Details</h1>
                <p class="text-muted mb-0 small">Examine the details of this movie screening schedule</p>
            </div>
        </div>

        <!-- Glass card Details -->
        <div class="glass-panel p-5 text-white mb-4" style="background: rgba(15, 23, 42, 0.45); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 24px; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);">
            <div class="row g-5 align-items-center">
                <!-- Movie Poster -->
                <div class="col-12 col-md-4 text-center">
                    <div class="showtime-details-poster mx-auto" style="width: 200px; height: 300px; border-radius: 20px; overflow: hidden; border: 3px solid rgba(255, 255, 255, 0.1); box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);">
                        <img src="@(Model.Movie?.ImageURL ?? "")" alt="@(Model.Movie?.Name ?? "N/A")" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null;this.src='/images/default-poster.png';" />
                    </div>
                </div>

                <!-- Showtime Metadata -->
                <div class="col-12 col-md-8">
                    <span class="badge mb-2" style="background: rgba(6, 182, 212, 0.15); color: var(--cinema-accent-cyan); border: 1px solid rgba(6, 182, 212, 0.3); font-size: 0.85rem; padding: 6px 12px; border-radius: 8px;">
                        <i class="bi bi-film me-1"></i>@(Model.Movie?.Category?.Name ?? "General")
                    </span>
                    <h2 class="fw-bold text-white mb-4" style="font-size: 2.2rem; font-family: 'Outfit', sans-serif;">@(Model.Movie?.Name ?? "Movie N/A")</h2>
                    
                    <div class="row g-4" style="font-size: 1.05rem;">
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-3 py-2 border-bottom border-light-subtle" style="--bs-border-color: rgba(255, 255, 255, 0.07);">
                                <i class="bi bi-building text-info fs-4" style="width: 30px;"></i>
                                <div>
                                    <div class="text-muted small">Cinema</div>
                                    <span class="fw-semibold">@(Model.CinemaRoom?.Cinema?.Name ?? "N/A")</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-3 py-2 border-bottom border-light-subtle" style="--bs-border-color: rgba(255, 255, 255, 0.07);">
                                <i class="bi bi-door-open text-info fs-4" style="width: 30px;"></i>
                                <div>
                                    <div class="text-muted small">Screening Room</div>
                                    <span class="fw-semibold">@(Model.CinemaRoom?.Name ?? "N/A")</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-3 py-2 border-bottom border-light-subtle" style="--bs-border-color: rgba(255, 255, 255, 0.07);">
                                <i class="bi bi-play-circle text-success fs-4" style="width: 30px;"></i>
                                <div>
                                    <div class="text-muted small">Start Time</div>
                                    <span class="fw-semibold">@Model.StartTime.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-3 py-2 border-bottom border-light-subtle" style="--bs-border-color: rgba(255, 255, 255, 0.07);">
                                <i class="bi bi-stop-circle text-danger fs-4" style="width: 30px;"></i>
                                <div>
                                    <div class="text-muted small">End Time</div>
                                    <span class="fw-semibold">@Model.EndTime.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="d-flex align-items-center gap-3 py-3 border-bottom border-light-subtle" style="--bs-border-color: rgba(255, 255, 255, 0.07);">
                                <i class="bi bi-tag-fill text-warning fs-3" style="width: 30px;"></i>
                                <div>
                                    <div class="text-muted small">Ticket Price</div>
                                    <span class="fw-bold text-warning fs-4">@Model.Price.ToString("N0") đ</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions Row -->
            <div class="d-flex flex-sm-row flex-column gap-3 justify-content-end pt-4 border-top border-secondary-subtle mt-5">
                <a class="btn btn-premium-outline px-4 py-2" asp-action="Index" style="width: auto;">
                    <i class="bi bi-arrow-left-circle me-2"></i>Back to List
                </a>
