<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="order-success-card glass-panel text-center py-5 px-4 mt-4">
            <div class="success-checkmark mb-4">
                <i class="bi bi-check-lg"></i>
            </div>
            <h2 class="text-white mb-3 fw-bold">Order Completed!</h2>
            <p class="text-muted mb-4 px-3" style="line-height:1.6; font-size: 0.95rem;">
                Your tickets have been successfully purchased. You can view all your orders in the Orders section of your profile.
            </p>
            <hr style="border-color:rgba(255,255,255,0.08)" class="my-4" />
            <div class="d-flex flex-column gap-3 align-items-center">
                <a class="btn btn-movie-gradient py-2.5 w-100" style="max-width: 280px; font-weight: 600;" asp-controller="Orders" asp-action="Index" asp-route-searchEmail="@ViewBag.CustomerEmail">
                    <i class="bi bi-receipt me-2"></i>View Orders
                </a>
                <a class="btn btn-premium-outline py-2.5 w-100" style="max-width: 280px; font-weight: 600;" asp-controller="Movies" asp-action="Index">
                    <i class="bi bi-film me-2"></i>Browse More
                </a>
            </div>
        </div>
    </div>
</div>